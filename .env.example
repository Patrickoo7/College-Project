# Environment Configuration Example
# Copy this file to .env and fill in your values
# Environment variables override values in YAML config files

# =============================================================================
# ENVIRONMENT SELECTION
# =============================================================================
# Which environment to use: development, staging, production
ENV=development

# =============================================================================
# API CONFIGURATION
# =============================================================================
# Override API host and port
# APP_API__HOST=0.0.0.0
# APP_API__PORT=8000

# Enable/disable debug mode
# APP_DEBUG=true

# JWT Secret Key (REQUIRED in production if auth is enabled)
# APP_API__SECRET_KEY=your-super-secret-key-change-this-in-production

# Access token expiration (minutes)
# APP_API__ACCESS_TOKEN_EXPIRE_MINUTES=60

# CORS allowed origins (comma-separated)
# APP_API__CORS__ALLOWED_ORIGINS=https://example.com,https://app.example.com

# =============================================================================
# DATA CONFIGURATION
# =============================================================================
# Override data directories
# APP_DATA__RAW_DATA_DIR=data/raw
# APP_DATA__PROCESSED_DATA_DIR=data/processed

# =============================================================================
# MODEL CONFIGURATION
# =============================================================================
# Enable/disable GPU
# APP_MODEL__USE_GPU=false

# GPU device ID
# APP_MODEL__DEVICE_ID=0

# Number of parallel jobs
# APP_MODEL__N_JOBS=-1

# =============================================================================
# MLOPS CONFIGURATION
# =============================================================================
# Drift detection PSI threshold
# APP_MLOPS__DRIFT_DETECTION__PSI_THRESHOLD=0.2

# Monitoring accuracy drop threshold
# APP_MLOPS__MONITORING__ACCURACY_DROP_THRESHOLD=0.05

# Retraining performance threshold
# APP_MLOPS__RETRAINING__PERFORMANCE_THRESHOLD=0.05

# =============================================================================
# MLFLOW CONFIGURATION
# =============================================================================
# MLflow tracking URI
# APP_MLFLOW_TRACKING_URI=http://localhost:5000

# MLflow experiment name
# APP_MLFLOW_EXPERIMENT_NAME=heart_disease_prediction

# =============================================================================
# LOGGING CONFIGURATION
# =============================================================================
# Log level: DEBUG, INFO, WARNING, ERROR, CRITICAL
# APP_LOGGING__LEVEL=INFO

# Log file path
# APP_LOGGING__LOG_FILE=app.log

# =============================================================================
# DATABASE CONFIGURATION (if using external DB)
# =============================================================================
# APP_DATABASE__HOST=localhost
# APP_DATABASE__PORT=5432
# APP_DATABASE__NAME=heart_disease_db
# APP_DATABASE__USER=postgres
# APP_DATABASE__PASSWORD=your-secure-password

# =============================================================================
# CLOUD STORAGE (if using S3/GCS/Azure)
# =============================================================================
# AWS_ACCESS_KEY_ID=your-access-key
# AWS_SECRET_ACCESS_KEY=your-secret-key
# AWS_REGION=us-east-1
# S3_BUCKET=your-bucket-name

# =============================================================================
# MONITORING & ALERTING (if using external services)
# =============================================================================
# SENTRY_DSN=https://your-sentry-dsn
# SLACK_WEBHOOK_URL=https://hooks.slack.com/services/your-webhook
# PAGERDUTY_API_KEY=your-pagerduty-key

# =============================================================================
# FEATURE FLAGS
# =============================================================================
# Enable specific features
# APP_FEATURE_ENGINEERING__INCLUDE_POLYNOMIAL=false
# APP_API__ENABLE_AUTH=false
